{
  "name": "imewlconverter-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/build-wasm.mjs --if-missing && vite --host 127.0.0.1",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "pnpm build:wasm && tsc -b && vite build && vite build --ssr src/prerender.tsx --outDir .prerender && node scripts/prerender.mjs",
    "check": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:online": "node scripts/test-browser.mjs --online",
    "test:formats": "node scripts/test-browser.mjs --formats",
    "preview": "vite preview --host 127.0.0.1",
    "build:cloudflare": "pnpm build && node scripts/prepare-cloudflare.mjs",
    "deploy": "pnpm build:cloudflare && cf deploy --prebuilt --mode production",
    "cache:app": "node scripts/cache-app-store.mjs",
    "test:seo": "node --test tests/seo/build.mjs",
    "test:localization": "node scripts/test-browser.mjs --localization"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@react-spectrum/provider": "^3.0.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "cf": "0.15.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
